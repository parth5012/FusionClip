# FusionClip Environment Variables

# General
NODE_ENV=development
PORT=3000

# Next.js Frontend URL (for CORS and API routing)
NEXT_PUBLIC_API_URL=http://localhost:8000

# FastAPI Backend API Configuration
BACKEND_PORT=8000
DATABASE_URL=postgresql://fusionclip:fusionclip123@db:5432/fusionclip
REDIS_URL=redis://redis:6379/0

# Comma-separated list of browser origins allowed to call the API.
# A wildcard is NOT supported here: credentials are enabled, and browsers
# reject "*" combined with allow_credentials.
CORS_ORIGINS=http://localhost:3000

# Master passphrase used to Fernet-encrypt third-party provider API keys
# (Gemini, ElevenLabs) stored server-side in the `configurations` table.
# The backend logs a loud WARNING while this is left at the dev default.
FUSIONCLIP_SECRET_KEY=fusionclip-dev-insecure-key-change-me

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=fusionclip_admin
MINIO_ROOT_PASSWORD=fusionclip_password123
MINIO_ENDPOINT=minio:9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=fusionclip-media
MINIO_USE_SSL=false
# External endpoint (used by client browser to resolve links directly)
MINIO_EXTERNAL_ENDPOINT=http://localhost:9000

# GPU Configuration (Optional)
NVIDIA_VISIBLE_DEVICES=all
